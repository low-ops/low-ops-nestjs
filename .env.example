# Local default is 3000. Docker image listens on 8000.
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=people_desk

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket only, or bucket/prefix (e.g. apps-cinaq-dev-bucket/nest-new-dev)
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_SERVICE_NAME=us-east-1
S3_PERFORM_DELETE=true
